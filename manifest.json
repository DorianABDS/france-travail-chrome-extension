{
  "manifest_version": 3,
  "name": "Auto-actualisation France Travail",
  "version": "1.2.0",
  "description": "Faites votre actualisation mensuelle France Travail en un clic, avec vos réponses, et suivez chaque étape.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Auto-actualisation France Travail",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "assets/script/background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.francetravail.fr/*"
      ],
      "js": [
        "assets/script/shared.js",
        "assets/script/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/style/panel.css"
      ],
      "matches": [
        "https://*.francetravail.fr/*"
      ]
    }
  ]
}
